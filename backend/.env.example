# Même projet Supabase que l'app principale (Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=votre_service_role_key

# Clé de signature des sessions (n'importe quelle longue chaîne aléatoire)
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Adresse(s) du frontend autorisée(s) (CORS), séparées par des virgules
FRONTEND_URL=http://localhost:5173

PORT=3001
